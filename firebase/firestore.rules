rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per participant, doc ID is a client-generated UUID stored in
    // their browser's localStorage. There is no real auth in this low-stakes
    // internal tool, so anyone holding that ID can update the name on it —
    // an accepted tradeoff for a company security-awareness event.
    match /participants/{participantId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60;
      allow delete: if false;
    }

    // One doc per (participant, challenge) solve, doc ID is
    // "<participantId>_<challengeId>" so re-submitting the same flag
    // upserts instead of creating duplicate leaderboard entries. Points are
    // never trusted from the client — the leaderboard recomputes them from
    // the challenge's known point value and the hint costs actually used.
    match /solves/{solveId} {
      allow read: if true;
      allow create, update: if request.resource.data.participantId is string
                    && request.resource.data.participantId.size() > 0
                    && request.resource.data.challengeId is string
                    && request.resource.data.challengeId.size() > 0
                    && request.resource.data.hintsUsed is int
                    && request.resource.data.hintsUsed >= 0
                    && request.resource.data.hintsUsed <= 10;
      allow delete: if false;
    }
  }
}
